<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WinNewsWire.AppShared</RootNamespace>
    <AssemblyName>WinNewsWire.AppShared</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Parsers\Parsers.csproj" />
    <ProjectReference Include="..\Web\Web.csproj" />
    <ProjectReference Include="..\Articles\Articles.csproj" />
    <ProjectReference Include="..\ArticlesDatabase\ArticlesDatabase.csproj" />
    <ProjectReference Include="..\SyncDatabase\SyncDatabase.csproj" />
    <ProjectReference Include="..\FeedFinder\FeedFinder.csproj" />
    <ProjectReference Include="..\Tree\Tree.csproj" />
    <ProjectReference Include="..\Account\Account.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\DefaultFeeds.opml" />
    <EmbeddedResource Include="Resources\template.html" />
    <EmbeddedResource Include="Resources\stylesheet.css" />
    <EmbeddedResource Include="Resources\core.css" />
    <EmbeddedResource Include="Resources\main.js" />
    <EmbeddedResource Include="Resources\newsfoot.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SmartReader" Version="0.11.0" />
  </ItemGroup>
</Project>
