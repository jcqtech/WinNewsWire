<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.AppWindows.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="About WinNewsWire">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <StackPanel Padding="32" Spacing="12" HorizontalAlignment="Center">
        <Image Source="ms-appx:///Assets/wnw.png" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock Text="WinNewsWire" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                   Text="A Windows port of NetNewsWire. Based on open source code by Ranchero Software and the NetNewsWire contributors." />
        <HyperlinkButton NavigateUri="https://winnewswire.com/" Content="winnewswire.com" HorizontalAlignment="Center" />
        <Button Content="Close" Click="Close_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</Window>
