<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.AppWindows.KeyboardShortcutsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="Keyboard Shortcuts">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <ScrollViewer Padding="24">
        <StackPanel Spacing="8" MinWidth="420">
            <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Navigation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="24" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="J / Down" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Next article" />
                <TextBlock Grid.Row="1" Text="K / Up" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous article" />
                <TextBlock Grid.Row="2" Text="Space" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Scroll article / next unread" />
                <TextBlock Grid.Row="3" Text="Enter" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Open in browser" />
            </Grid>
            <TextBlock Text="Article Actions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="24" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="R" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Toggle read" />
                <TextBlock Grid.Row="1" Text="L / S" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Toggle starred" />
                <TextBlock Grid.Row="2" Text="Ctrl+M" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Mark all as read" />
                <TextBlock Grid.Row="3" Text="Ctrl+R" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Refresh all feeds" />
                <TextBlock Grid.Row="4" Text="Ctrl+," FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Preferences" />
            </Grid>
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Window>
