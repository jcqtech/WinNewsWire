<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.AppWindows.ErrorLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="Error Log">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Error Log" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ListView Grid.Row="1" x:Name="EntriesList" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8" Spacing="2">
                        <TextBlock Text="{Binding Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Clear" Click="Clear_Click" />
            <Button Content="Close" Click="Close_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
