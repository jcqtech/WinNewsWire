<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.AppWindows.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Preferences">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid Padding="32,40,32,24">
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="56" />
            </Style>
            <!-- Match the closed-state Expander header height to a regular card. -->
            <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="56" />
            </Style>
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="OptionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- A single row inside the "Advanced" continuous box: icon + label + toggle.
                 No surrounding Border so consecutive rows visually flow as one panel. -->
            <Style x:Key="AdvancedRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      Padding="0,0,4,0">
            <Grid x:Name="ContentLayout" ColumnSpacing="32" RowSpacing="16">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="WideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <!-- Re-flow the right-hand "About" panel under the
                                     left-hand options column when the window is too
                                     narrow to fit them side-by-side. -->
                                <Setter Target="RightPanel.(Grid.Row)" Value="2" />
                                <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                                <Setter Target="RightPanel.Width" Value="NaN" />
                                <Setter Target="RightPanel.Margin" Value="0,12,0,0" />
                                <Setter Target="RightCol.Width" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <!-- Title scrolls with content (no longer pinned). -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightCol" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Preferences"
                           Style="{StaticResource TitleTextBlockStyle}" FontSize="36"
                           Margin="0,0,0,16" />

                <!-- ============================ LEFT PANEL ============================ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8"
                            VerticalAlignment="Top" MinWidth="460">

                    <!-- General -->
                    <TextBlock Text="General" Style="{StaticResource SectionHeadingStyle}"
                               Margin="2,0,0,4" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72C;" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Refresh feeds" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2" x:Name="RefreshIntervalCombo" MinWidth="180"
                                      SelectionChanged="RefreshIntervalCombo_SelectionChanged" />
                        </Grid>
                    </Border>

                    <!-- Reading -->
                    <TextBlock Text="Reading" Style="{StaticResource SectionHeadingStyle}"
                               Margin="2,12,0,4" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Article text size" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2" x:Name="TextSizeCombo" MinWidth="180"
                                      SelectionChanged="TextSizeCombo_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8FD;" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Group timeline by feed" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" x:Name="GroupByFeedToggle"
                                          MinWidth="0" Margin="0"
                                          Toggled="GroupByFeed_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Open links in browser in background" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" x:Name="OpenBackgroundToggle"
                                          MinWidth="0" Margin="0"
                                          Toggled="OpenBackground_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Article theme" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="ThemeCombo" MinWidth="160"
                                          SelectionChanged="ThemeCombo_SelectionChanged" />
                                <Button x:Name="OpenThemesFolderButton" Click="OpenThemesFolder_Click"
                                        ToolTipService.ToolTip="Open Themes folder in Explorer">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notifications -->
                    <TextBlock Text="Notifications" Style="{StaticResource SectionHeadingStyle}"
                               Margin="2,12,0,4" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEA8F;" Style="{StaticResource OptionIconStyle}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="Show toasts for new articles" />
                                <ToggleSwitch Grid.Column="2" x:Name="NotificationsEnabledToggle"
                                              MinWidth="0" Margin="0"
                                              Toggled="NotificationsEnabled_Changed" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Per-feed notification toggles live in each feed's right-click menu in the sidebar. Toast delivery also depends on Windows notification permissions for this app." />
                            <HyperlinkButton x:Name="OpenNotificationSettingsLink"
                                             Content="Open Windows notification settings…"
                                             Click="OpenNotificationSettings_Click"
                                             Padding="0" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced -->
                    <TextBlock Text="Advanced" Style="{StaticResource SectionHeadingStyle}"
                               Margin="2,12,0,4" />

                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="Advanced options" VerticalAlignment="Center" />
                        </Expander.Header>
                        <!-- Single continuous box: rows are siblings inside a StackPanel
                             with no spacing and no per-row borders, so they read as one
                             panel rather than discrete cards. -->
                        <StackPanel Spacing="0" Padding="0,4,0,0">
                            <Grid Style="{StaticResource AdvancedRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9F1;" Style="{StaticResource OptionIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Use reader view by default" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" x:Name="ReaderModeDefaultToggle"
                                              MinWidth="0" Margin="0" Toggled="Advanced_Changed" />
                            </Grid>
                            <Grid Style="{StaticResource AdvancedRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE943;" Style="{StaticResource OptionIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Allow JavaScript in article content (may affect layout)"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" x:Name="JavascriptToggle"
                                              MinWidth="0" Margin="0" Toggled="Advanced_Changed" />
                            </Grid>
                            <Grid Style="{StaticResource AdvancedRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" Style="{StaticResource OptionIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Show debug menu" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="2" x:Name="DebugMenuToggle"
                                              MinWidth="0" Margin="0" Toggled="Advanced_Changed" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Accounts -->
                    <TextBlock Text="Accounts" Style="{StaticResource SectionHeadingStyle}"
                               Margin="2,12,0,4" />

                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE77B;" Style="{StaticResource OptionIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Manage accounts" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="SelectedAccountText"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="None" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8">
                            <ListView x:Name="AccountsList" MaxHeight="240" SelectionMode="Single"
                                      SelectionChanged="AccountsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MinWidth="200" />
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add Account..." Click="AddAccount_Click" />
                                <Button Content="Remove" Click="RemoveAccount_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- ============================ RIGHT PANEL ============================ -->
                <StackPanel x:Name="RightPanel" Grid.Row="1" Grid.Column="1"
                            Spacing="12" Width="280" VerticalAlignment="Top">
                    <TextBlock Text="About this app" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="WinNewsWire is a free, native Windows feed reader for keeping up with your favorite news sources via RSS, Atom, and JSON feeds. It can sync with services like Feedbin, Feedly, NewsBlur, and other Reader API providers." />

                    <TextBlock Text="Acknowledgements" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="This app uses the following open-source libraries:" />
                    <StackPanel Spacing="0">
                        <HyperlinkButton Content="Windows App SDK (MIT)" NavigateUri="https://github.com/microsoft/WindowsAppSDK/blob/main/LICENSE" Padding="0,2" />
                        <HyperlinkButton Content="CommunityToolkit.Mvvm (MIT)" NavigateUri="https://github.com/CommunityToolkit/dotnet/blob/main/License.md" Padding="0,2" />
                        <HyperlinkButton Content="Microsoft.Data.Sqlite (MIT)" NavigateUri="https://github.com/dotnet/efcore/blob/main/LICENSE.txt" Padding="0,2" />
                        <HyperlinkButton Content="HtmlAgilityPack (MIT)" NavigateUri="https://github.com/zzzprojects/html-agility-pack/blob/master/LICENSE" Padding="0,2" />
                        <HyperlinkButton Content="SmartReader (Apache-2.0)" NavigateUri="https://github.com/Strumenta/SmartReader/blob/master/LICENSE" Padding="0,2" />
                        <HyperlinkButton Content="Markdig (BSD-2-Clause)" NavigateUri="https://github.com/xoofx/markdig/blob/master/license.txt" Padding="0,2" />
                        <HyperlinkButton Content="System.ServiceModel.Syndication (MIT)" NavigateUri="https://github.com/dotnet/wcf/blob/main/LICENSE.TXT" Padding="0,2" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Spacing="8" Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                        <Button Content="Send feedback" Width="160" Click="SendFeedback_Click" />
                        <Button Content="Help" Width="160" Click="Help_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
