<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.AppWindows.FeedbackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="Send Feedback">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

    <Grid>
        <!-- Form panel -->
        <ScrollViewer x:Name="FormPanel" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Padding="24,24,24,24">
                <TextBlock Text="Send Feedback"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Tell us what you think — your message is emailed to the WinNewsWire team using your default mail client." />

                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <TextBlock Text="How was your experience?" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="ThumbsUpButton" Click="ThumbsUp_Click"
                                  MinWidth="64" MinHeight="48"
                                  ToolTipService.ToolTip="I liked it">
                        <FontIcon Glyph="&#xE19E;" FontSize="20" />
                    </ToggleButton>
                    <ToggleButton x:Name="ThumbsDownButton" Click="ThumbsDown_Click"
                                  MinWidth="64" MinHeight="48"
                                  ToolTipService.ToolTip="It needs work">
                        <FontIcon Glyph="&#xE19F;" FontSize="20" />
                    </ToggleButton>
                </StackPanel>

                <TextBlock Text="What would you like to tell us?" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                <TextBox x:Name="FeedbackBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="140"
                         MaxHeight="240"
                         PlaceholderText="Describe what worked, what didn't, or what you'd like to see…"
                         TextChanged="FeedbackBox_TextChanged" />

                <CheckBox x:Name="IncludeScreenshotCheckBox"
                          Content="Include a screenshot of WinNewsWire"
                          Margin="0,4,0,0" />

                <CheckBox x:Name="IncludeDebugCheckBox"
                          Content="Include debug information"
                          IsChecked="True" />
                <Expander Header="Preview debug information"
                          HorizontalAlignment="Stretch"
                          MaxHeight="200">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <TextBlock x:Name="DebugInfoText"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </Expander>

                <CheckBox x:Name="ContactMeCheckBox"
                          Content="You may contact me about this feedback"
                          Checked="ContactMe_Changed"
                          Unchecked="ContactMe_Changed"
                          Margin="0,4,0,0" />
                <StackPanel x:Name="EmailRow" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="Email address" />
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="you@example.com"
                             InputScope="EmailSmtpAddress"
                             TextChanged="EmailBox_TextChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="SendButton" Content="Send Feedback" Click="Send_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirmation panel -->
        <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Spacing="14"
                    Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
            <FontIcon Glyph="&#xE73E;" FontSize="48"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="Thanks for the feedback!"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Your message has been handed off to your email client. You can edit it once more before hitting send." />

            <StackPanel x:Name="StoreRatingPanel" Visibility="Collapsed"
                        Spacing="8" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Text="If WinNewsWire's been useful, would you mind rating it on the Microsoft Store?" />
                <Button Content="Rate WinNewsWire on the Microsoft Store"
                        Click="RateInStore_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <Button Content="Done" Click="Done_Click" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
