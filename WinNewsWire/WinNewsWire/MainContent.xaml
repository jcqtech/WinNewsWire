<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinNewsWire.MainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsWire"
    xmlns:converters="using:WinNewsWire.Converters"
    xmlns:models="using:WinNewsWire.Models"
    xmlns:helpers="using:WinNewsWire.Helpers"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
        <converters:RelativeTimeConverter x:Key="RelativeTime" />
        <converters:UnreadCountToVisibilityConverter x:Key="UnreadCountToVisibility" />
        <converters:IsReadToUnreadDotConverter x:Key="IsReadToUnreadDot" />
        <converters:StarredToGlyphConverter x:Key="StarredToGlyph" />
        <converters:PathToImageSourceConverter x:Key="PathToImage" />
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="J" Invoked="AccelNext_Invoked" />
        <KeyboardAccelerator Key="K" Invoked="AccelPrev_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Control" Invoked="AccelNext_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Control" Invoked="AccelPrev_Invoked" />
        <KeyboardAccelerator Key="R" Invoked="AccelRefresh_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="AccelRefresh_Invoked" />
        <KeyboardAccelerator Key="M" Invoked="AccelMarkRead_Invoked" />
        <KeyboardAccelerator Key="S" Invoked="AccelToggleStar_Invoked" />
        <KeyboardAccelerator Key="L" Invoked="AccelToggleStar_Invoked" />
        <KeyboardAccelerator Key="U" Invoked="AccelMarkRead_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="AccelMarkAllRead_Invoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="AccelInspector_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AccelNewFeed_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control,Shift" Invoked="AccelToggleSidebar_Invoked" />
        <KeyboardAccelerator Key="W" Modifiers="Control,Shift" Invoked="AccelReaderMode_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Three-Panel Layout -->
        <Grid Grid.Row="0" x:Name="MainContentGrid" SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="200" MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="580" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar — transparent so Window's Mica backdrop shows through -->
            <Grid Grid.Column="0" x:Name="SidebarPanel"
                  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2"
                            Padding="8,6" HorizontalAlignment="Right">
                    <Button x:Name="ReloadButton" Click="ReloadButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Reload all feeds"
                            Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>

                    <DropDownButton x:Name="AddDropdown"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Add feed or folder"
                                    Height="32" Padding="6,0">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="New Feed..." Click="NewFeed_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE774;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="New Folder..." Click="NewFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <TreeView Grid.Row="1" x:Name="SidebarTreeView"
                  ItemInvoked="SidebarTreeView_ItemInvoked"
                  SelectionMode="Single"
                  Padding="0,0,4,8"
                  CanDragItems="True"
                  CanReorderItems="True"
                  AllowDrop="True"
                  DragItemsCompleted="SidebarTreeView_DragItemsCompleted">
            <TreeView.ItemContainerStyle>
                <Style TargetType="muxc:TreeViewItem">
                    <Setter Property="Padding" Value="0,0,0,0" />
                    <Setter Property="MinHeight" Value="28" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <DataTemplate x:Key="SidebarRowTemplate" x:DataType="muxc:TreeViewNode">
                    <Grid ColumnSpacing="4" Margin="-24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="16" Height="16"
                               Source="{x:Bind ((models:SidebarItem)Content).FaviconPath, Mode=OneWay, Converter={StaticResource PathToImage}}" />

                        <!-- Read-only label (hidden during inline rename) -->
                        <TextBlock Grid.Column="1" Text="{x:Bind ((models:SidebarItem)Content).Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   IsTextTrimmedChanged="SidebarTitle_IsTextTrimmedChanged"
                                   Loaded="SidebarTitle_Loaded"
                                   Visibility="{x:Bind ((models:SidebarItem)Content).IsRenaming, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />

                        <!-- Inline rename editor (visible only during rename) -->
                        <Grid Grid.Column="1"
                              VerticalAlignment="Center"
                              ColumnSpacing="2"
                              Visibility="{x:Bind ((models:SidebarItem)Content).IsRenaming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind ((models:SidebarItem)Content).EditableTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="28"
                                     Padding="6,2"
                                     VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"
                                     HorizontalAlignment="Stretch"
                                     Loaded="SidebarRenameBox_Loaded"
                                     GotFocus="SidebarRenameBox_GotFocus"
                                     LostFocus="SidebarRenameBox_LostFocus"
                                     KeyDown="SidebarRenameBox_KeyDown" />
                            <Button Grid.Column="1" Click="SidebarRenameAccept_Click"
                                    Width="28" Height="28" Padding="0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Rename">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" />
                            </Button>
                            <Button Grid.Column="2" Click="SidebarRenameCancel_Click"
                                    Width="28" Height="28" Padding="0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Cancel">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <Border Grid.Column="2"
                                Padding="6,0"
                                MinWidth="20" Height="18"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ((models:SidebarItem)Content).UnreadCount, Mode=OneWay, Converter={StaticResource UnreadCountToVisibility}}">
                            <TextBlock Text="{x:Bind ((models:SidebarItem)Content).UnreadCount, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="SidebarSectionHeaderTemplate" x:DataType="muxc:TreeViewNode">
                    <!-- Non-interactive heading. The negative left margin matches the
                         row template so the heading aligns with regular row icons.
                         The Loaded handler walks up to the parent TreeViewItem and
                         disables hit-testing/tab-stop so the heading can't be
                         clicked, hovered, selected, or dragged. -->
                    <TextBlock Margin="-24,12,0,4"
                               Text="{x:Bind ((models:SidebarItem)Content).Title, Mode=OneWay}"
                               FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="60"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Loaded="SidebarSectionHeader_Loaded" />
                </DataTemplate>
                <helpers:SidebarItemTemplateSelector x:Key="SidebarTemplateSelector"
                    DefaultTemplate="{StaticResource SidebarRowTemplate}"
                    SectionHeaderTemplate="{StaticResource SidebarSectionHeaderTemplate}" />
            </TreeView.Resources>
            <TreeView.ItemTemplateSelector>
                <StaticResource ResourceKey="SidebarTemplateSelector" />
            </TreeView.ItemTemplateSelector>
            <TreeView.ContextFlyout>
                <MenuFlyout x:Name="SidebarContextMenu" Opening="SidebarContextMenu_Opening" />
            </TreeView.ContextFlyout>
        </TreeView>
                <!-- Sidebar status (accounts · feeds · unread) -->
                <Border Grid.Row="2" Padding="12,4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{x:Bind ViewModel.SidebarStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <!-- Sidebar Splitter (drag handle) -->
            <Grid x:Name="SidebarSplitter" Grid.Column="1" Width="4" Background="Transparent"
                  PointerPressed="SidebarSplitter_PointerPressed"
                  PointerMoved="SidebarSplitter_PointerMoved"
                  PointerReleased="Splitter_PointerReleased"
                  PointerEntered="Splitter_PointerEntered"
                  PointerExited="Splitter_PointerExited" />

            <!-- Rounded container for Article List + Content (Edge-style) -->
            <Border Grid.Column="2"
                    x:Name="ContentContainer"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Margin="0,4,4,0"
                    Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid x:Name="ArticleContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ArticleListColumn" Width="380" MinWidth="280" MaxWidth="600" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Article List -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ListView fills entire space; top padding for floating toolbar -->
                        <ListView x:Name="ArticleListView"
                                  Grid.Row="0"
                                  ItemsSource="{x:Bind ViewModel.ArticleItems, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedArticle, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Padding="0,56,0,4">
                            <ListView.ContextFlyout>
                                <MenuFlyout x:Name="ArticleContextMenu" Opening="ArticleContextMenu_Opening" />
                            </ListView.ContextFlyout>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="4,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FeedItem">
                                    <Grid ColumnSpacing="10"
                                          ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="12" VerticalAlignment="Top" Margin="0,4,0,0">
                                            <Ellipse Width="8" Height="8"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                     Visibility="{x:Bind ShowUnreadDot, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Glyph="&#xE735;" FontSize="12"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      ToolTipService.ToolTip="Starred"
                                                      Visibility="{x:Bind ShowStar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <Border Grid.Column="1"
                                                Width="48" Height="48" CornerRadius="4"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Stretch="Uniform"
                                                   Source="{x:Bind FaviconPath, Mode=OneWay, Converter={StaticResource PathToImage}}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock helpers:HtmlInlines.Html="{x:Bind Title, Mode=OneWay}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock helpers:HtmlInlines.Html="{x:Bind Summary, Mode=OneWay}"
                                                       helpers:HtmlInlines.MaxLength="280"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FeedTitle, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind PublishedDate, Mode=OneWay, Converter={StaticResource RelativeTime}}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Floating acrylic toolbar -->
                        <Grid Grid.Row="0" VerticalAlignment="Top" Padding="12,8"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">
                            <Grid.Background>
                                <AcrylicBrush TintColor="{ThemeResource LayerFillColorDefault}"
                                              TintOpacity="0.65"
                                              FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                <Button x:Name="ToggleSidebarButton" Click="ToggleSidebarButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Toggle sidebar"
                                        Width="36" Height="36" Padding="0">
                                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="ArticleListTitleText"
                                           Text="{x:Bind ViewModel.ArticleListTitle, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10" Padding="8,2"
                                    Visibility="{x:Bind ViewModel.ArticleListUnreadCount, Mode=OneWay, Converter={StaticResource UnreadCountToVisibility}}">
                                <TextBlock Text="{x:Bind ViewModel.ArticleListUnreadCount, Mode=OneWay}"
                                           FontSize="12" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- Timeline status (N articles · unread · starred) -->
                        <Border Grid.Row="1" Padding="12,4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="{x:Bind ViewModel.TimelineStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>

                    <!-- Single-line divider between article list and content -->
                    <Grid Grid.Column="1" Width="5" Background="Transparent"
                          PointerPressed="ArticleSplitter_PointerPressed"
                          PointerMoved="ArticleSplitter_PointerMoved"
                          PointerReleased="Splitter_PointerReleased"
                          PointerEntered="Splitter_PointerEntered"
                          PointerExited="Splitter_PointerExited">
                        <Rectangle Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <!-- Content Pane -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Content Toolbar -->
                        <Grid Grid.Row="0" Padding="12,8"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">

                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Click="StarButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Star article"
                                        Width="36" Height="36" Padding="0">
                                    <FontIcon x:Name="StarButtonIcon" Glyph="&#xE734;" FontSize="16" />
                                </Button>
                                <Button Click="MarkAllReadButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Mark all as read"
                                        Width="36" Height="36" Padding="0">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                </Button>
                                <ToggleButton x:Name="ReaderModeToggle"
                                        IsChecked="{x:Bind ViewModel.IsReaderMode, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Reader view (Ctrl+Shift+W)"
                                        Width="36" Height="36" Padding="0" MinWidth="36">
                                    <FontIcon Glyph="&#xE8A1;" FontSize="16" />
                                </ToggleButton>
                                <Button Click="ShareButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Share"
                                        Width="36" Height="36" Padding="0">
                                    <FontIcon Glyph="&#xE72D;" FontSize="16" />
                                </Button>
                                <Button Click="OpenInBrowserButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Open in browser"
                                        Width="36" Height="36" Padding="0">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- WebView2 for article content -->
                        <WebView2 Grid.Row="1" x:Name="ContentWebView"
                                  DefaultBackgroundColor="Transparent" />

                        <!-- Empty state overlay -->
                        <Grid Grid.Row="1" x:Name="EmptyContentState"
                              Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE7BC;" FontSize="48"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Select an article to read"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Detail status (feed · author · date · reader view) -->
                        <Border Grid.Row="2" Padding="12,4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="{x:Bind ViewModel.DetailStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
