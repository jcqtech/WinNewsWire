<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsWire.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsWire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinNewsWire">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0,188,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitlePanel" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="12" Margin="0,0,16,0">
                <Image Source="ms-appx:///Assets/wnw-flat.png" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="WinNewsWire" Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <AutoSuggestBox Grid.Column="1" x:Name="TitleBarSearchBox"
                            PlaceholderText="Search articles"
                            QueryIcon="Find"
                            MaxWidth="480"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            TextChanged="TitleBarSearchBox_TextChanged"
                            QuerySubmitted="TitleBarSearchBox_QuerySubmitted" />
        </Grid>

        <!-- Full menu bar (File/Edit/View/Article/Feed/Window/Help) — ports Mac NNW MainMenu.
             AccessKey on each MenuBarItem/MenuFlyoutItem/MenuFlyoutSubItem enables the
             standard Windows Alt-key mnemonic flow (Alt opens the bar; Alt+F opens File;
             N triggers New Feed; etc.). Letters are chosen to be unique within each
             menu's scope. -->
        <MenuBar Grid.Row="1" x:Name="AppMenuBar">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="New Feed…" AccessKey="N" Click="Menu_NewFeed">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="New Folder…" AccessKey="F" Click="Menu_NewFolder">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Import" AccessKey="I">
                    <MenuFlyoutItem Text="Import OPML…" AccessKey="O" Click="ImportOpml_Click" />
                    <MenuFlyoutItem Text="Import NNW3 Subscriptions…" AccessKey="N" Click="ImportNnw3_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Export OPML…" AccessKey="E" Click="ExportOpml_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="PreferencesMenuItem" Text="Preferences…" AccessKey="P"
                                KeyboardAcceleratorTextOverride="Ctrl+/"
                                Click="Preferences_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close Window" AccessKey="C" Click="Menu_CloseWindow">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Quit WinNewsWire" AccessKey="Q" Click="Menu_Quit">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Q" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit" AccessKey="E">
                <MenuFlyoutItem Text="Undo" AccessKey="U" Click="Menu_Undo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Redo" AccessKey="R" Click="Menu_Redo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Cut" AccessKey="T" Click="Menu_Cut">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy" AccessKey="C" Click="Menu_Copy">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Paste" AccessKey="P" Click="Menu_Paste">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Select All" AccessKey="A" Click="Menu_SelectAll">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="A" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" AccessKey="F" Click="Menu_Find">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="View" AccessKey="V">
                <ToggleMenuFlyoutItem x:Name="MenuUnifiedLayout" Text="Unified Layout"
                                      AccessKey="U" Click="Menu_ToggleUnified" />
                <ToggleMenuFlyoutItem x:Name="MenuShowSidebar" Text="Show Sidebar"
                                      AccessKey="S"
                                      IsChecked="True" Click="Menu_ToggleSidebar">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="B" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="MenuReaderMode" Text="Reader View"
                                      AccessKey="R"
                                      Click="Menu_ToggleReaderMode">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="W" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="MenuThemes" Text="Article Theme" AccessKey="T" />
                <MenuFlyoutItem Text="Install Theme From File…" AccessKey="I" Click="Menu_InstallTheme" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Appearance" AccessKey="P">
                    <ToggleMenuFlyoutItem x:Name="MenuAppearanceSystem" Text="Use System Setting" AccessKey="S"
                                          Click="Menu_AppearanceSystem" />
                    <ToggleMenuFlyoutItem x:Name="MenuAppearanceLight" Text="Light" AccessKey="L"
                                          Click="Menu_AppearanceLight" />
                    <ToggleMenuFlyoutItem x:Name="MenuAppearanceDark" Text="Dark" AccessKey="D"
                                          Click="Menu_AppearanceDark" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Refresh All" AccessKey="A" Click="Menu_Refresh">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Article" AccessKey="A">
                <MenuFlyoutItem Text="Mark as Read/Unread" AccessKey="M" Click="Menu_ToggleRead">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="U" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Star/Unstar" AccessKey="S" Click="Menu_ToggleStar">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Next Unread" AccessKey="U" Click="Menu_NextUnread">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Space" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Next" AccessKey="N" Click="Menu_Next" />
                <MenuFlyoutItem Text="Previous" AccessKey="P" Click="Menu_Prev" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open in Browser" AccessKey="O" Click="Menu_OpenBrowser">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy Link" AccessKey="C" Click="Menu_CopyLink" />
                <MenuFlyoutItem Text="Share…" AccessKey="H" Click="Menu_Share" />
            </MenuBarItem>

            <MenuBarItem Title="Feed" AccessKey="D">
                <MenuBarItem.Resources>
                    <!-- Items in a MenuBarItem can't directly bind IsEnabled to view-model
                         state without DataContext gymnastics; we wire it up in the
                         MenuFlyout.Opening event instead, on the MenuBarItem itself. -->
                </MenuBarItem.Resources>
                <MenuFlyoutItem Text="Add Feed…" AccessKey="A" Click="Menu_NewFeed" />
                <MenuFlyoutItem Text="Get Info…" AccessKey="I" Click="Menu_GetInfo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuRenameItem" Text="Rename…" AccessKey="R" Click="Menu_Rename" />
                <MenuFlyoutItem Text="Delete" AccessKey="D" Click="Menu_Delete" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Mark All as Read" AccessKey="M" Click="Menu_MarkAllRead">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="K" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Refresh" AccessKey="F" Click="Menu_Refresh" />
            </MenuBarItem>

            <MenuBarItem Title="Window" AccessKey="W">
                <MenuFlyoutItem Text="Minimize" AccessKey="M" Click="Menu_Minimize">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="M" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Zoom" AccessKey="Z" Click="Menu_Zoom" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Keyboard Shortcuts" AccessKey="K" Click="KeyboardShortcuts_Click" />
                <MenuFlyoutItem Text="Error Log" AccessKey="E" Click="ErrorLog_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="About WinNewsWire" AccessKey="A" Click="About_Click" />
                <MenuFlyoutItem Text="Send Feedback…" AccessKey="F" Click="Feedback_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="WinNewsWire Help" AccessKey="H" Click="Menu_HelpHome" />
                <MenuFlyoutItem Text="WinNewsWire Website" AccessKey="W" Click="Menu_Website" />
                <MenuFlyoutItem Text="Release Notes" AccessKey="R" Click="Menu_ReleaseNotes" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="GitHub Repository" AccessKey="G" Click="Menu_GithubRepo" />
                <MenuFlyoutItem Text="Report a Bug…" AccessKey="B" Click="Menu_BugTracker" />
                <MenuFlyoutItem Text="Community Forum" AccessKey="C" Click="Menu_Discourse" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Privacy Policy" AccessKey="P" Click="Menu_PrivacyPolicy" />
            </MenuBarItem>
        </MenuBar>

        <!-- Main Content -->
        <local:MainContent x:Name="MainContentControl" Grid.Row="2" />
    </Grid>
</Window>
