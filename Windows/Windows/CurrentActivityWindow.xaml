<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinNewsWire.AppWindows.CurrentActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Current Activity">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ListView Grid.Row="1" x:Name="Activities" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid AutomationProperties.Name="{Binding StateLabel}">
                            <FontIcon Glyph="&#xEA3A;" FontSize="12" Visibility="{Binding Pending}"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Glyph="&#xEA3B;" FontSize="12" Visibility="{Binding Running}"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Visibility="{Binding Completed}"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Glyph="&#xEA39;" FontSize="12" Visibility="{Binding Failed}"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Owner}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Owner}" />
                        <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Description}">
                            <Run Text="{Binding Title}" />
                            <Run Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,180,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="HelpButton" Click="Help_Click" />
                <Button x:Name="CloseButton" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
