<UserControl
    x:Class="WinNewsWire.Helpers.ThumbnailView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsWire.Helpers"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <Grid>
        <Border x:Name="Placeholder" CornerRadius="{Binding CornerRadius, ElementName=Root}"
                Style="{StaticResource ThumbnailPlaceholderStyle}" />
        <local:AspectFitPanel x:Name="ImageHost">
            <Border CornerRadius="{Binding CornerRadius, ElementName=Root}">
                <Image x:Name="ThumbnailImage" Stretch="Uniform" />
            </Border>
        </local:AspectFitPanel>
    </Grid>
</UserControl>
