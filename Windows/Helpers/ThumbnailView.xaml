<UserControl
    x:Class="WinNewsWire.Helpers.ThumbnailView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsWire.Helpers"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <UserControl.Style>
        <Style TargetType="local:ThumbnailView">
            <Setter Property="FillBrush" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Style>
    <Border CornerRadius="{Binding CornerRadius, ElementName=Root}">
        <Grid>
            <Border Background="{Binding FillBrush, ElementName=Root}" />
            <Border>
                <Border.Background>
                    <ImageBrush ImageSource="{Binding ImageSource, ElementName=Root}"
                                Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" />
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</UserControl>
