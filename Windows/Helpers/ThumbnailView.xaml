<UserControl
    x:Class="WinNewsWire.Helpers.ThumbnailView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <Border CornerRadius="{Binding CornerRadius, ElementName=Root}">
        <Grid>
            <Border x:Name="Placeholder" Background="{ThemeResource ControlAltFillColorTertiaryBrush}" />
            <Image Source="{Binding ImageSource, ElementName=Root}" Stretch="UniformToFill"
                   AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </Border>
</UserControl>
