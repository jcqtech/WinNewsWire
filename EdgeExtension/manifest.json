{
  "manifest_version": 3,
  "name": "Subscribe to Feed in WinNewsWire",
  "version": "1.0.0",
  "description": "Subscribe to the current page in WinNewsWire or your default feed reader.",
  "permissions": ["activeTab", "declarativeContent", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Subscribe to Feed",
    "default_state": "disabled",
    "default_icon": {
      "16": "icons/feed-16.png",
      "32": "icons/feed-32.png"
    }
  },
  "icons": {
    "16": "icons/feed-16.png",
    "32": "icons/feed-32.png",
    "48": "icons/feed-48.png",
    "128": "icons/feed-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
