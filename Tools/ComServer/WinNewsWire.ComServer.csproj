<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>WinNewsWire.ComServer</AssemblyName>
    <RootNamespace>WinNewsWire.Automation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ParityProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);PARITY_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Automation\Automation.csproj" />
    <ProjectReference Include="..\..\Modules\Core\Core.csproj" />
    <ProjectReference Include="..\..\Modules\ScriptingProtocol\ScriptingProtocol.csproj" />
    <InternalsVisibleTo Include="WinNewsWire.ComServer.Tests" />
  </ItemGroup>
</Project>
